# Save this as create-preview.ps1 and run it
Add-Type -AssemblyName System.Drawing

# Create the image
$image = New-Object System.Drawing.Bitmap(1280, 640)
$graphics = [System.Drawing.Graphics]::FromImage($image)

# Fill background
$graphics.FillRectangle([System.Drawing.Brushes]::DarkBlue, 0, 0, 1280, 640)

# Add your logo (if it exists)
if (Test-Path "logo.png") {
    $logo = [System.Drawing.Image]::FromFile("logo.png")
    $graphics.DrawImage($logo, 100, 170, 300, 300)
}

# Add text
$font = New-Object System.Drawing.Font("Arial", 48, [System.Drawing.FontStyle]::Bold)
$graphics.DrawString("Zs Cyber Protection Guard", $font, [System.Drawing.Brushes]::White, 450, 100)

$font = New-Object System.Drawing.Font("Arial", 36, [System.Drawing.FontStyle]::Regular)
$graphics.DrawString("CONTINUOUS CYBER ATTACK PROTECTION", $font, [System.Drawing.Brushes]::LightBlue, 450, 200)

$font = New-Object System.Drawing.Font("Arial", 28, [System.Drawing.FontStyle]::Regular)
$graphics.DrawString("🔄 PowerShell DNS Rotation Tool", $font, [System.Drawing.Brushes]::White, 450, 300)
$graphics.DrawString("🔒 Real-time Security Automation", $font, [System.Drawing.Brushes]::White, 450, 350)
$graphics.DrawString("github.com/ChiefBernard/", $font, [System.Drawing.Brushes]::Yellow, 450, 450)
$graphics.DrawString("CYBER-ATTACK-PROTECTION-Zs", $font, [System.Drawing.Brushes]::Yellow, 450, 500)

# Save
$graphics.Dispose()
$image.Save("social-preview.png")
$image.Dispose()

Write-Host "Preview image created: social-preview.png" -ForegroundColor Green
